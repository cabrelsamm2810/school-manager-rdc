generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  COORDINATION_NATIONALE
  COORDINATION_PROVINCIALE
  AGENT_PROVINCIAL
  COORDINATION_SOUS_PROVINCIALE
  AGENT_SOUS_PROVINCIAL
  DIRECTION_ECOLE
  ENSEIGNANT
  PARENT
  ELEVE
}

model User {
  id                    String   @id @default(cuid())
  nom                   String
  postNom               String   @default("")
  prenom                String
  sexe                  String   @default("")
  email                 String   @unique
  telephone             String   @default("")
  passwordHash          String
  role                  Role     @default(ELEVE)
  typeInstitution       String   @default("")
  institutionName      String   @default("")
  provinceAdministrative String  @default("")
  provinceEducationnelle String  @default("")
  bureauAffectation     String   @default("")
  fonction              String   @default("")
  grade                 String   @default("")
  dinacope              String   @default("")
  profilePhotoUrl       String?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Eleve {
  id              String    @id @default(cuid())
  matricule       String    @unique
  nom             String
  postNom         String    @default("")
  prenom          String
  sexe            String    @default("")
  dateNaissance   DateTime?
  lieuNaissance   String    @default("")
  classe          String
  telephone       String    @default("")
  email           String    @default("")
  adresse         String    @default("")
  nomTuteur       String    @default("")
  telephoneTuteur String    @default("")
  etablissementId String?
  etablissement   Etablissement? @relation(fields: [etablissementId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  presences  Presence[]

  @@index([classe])
  @@index([nom])
  @@index([etablissementId])
  @@map("eleves")
}

model Presence {
  id        String   @id @default(cuid())
  eleveId   String
  eleve     Eleve    @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  present   Boolean  @default(true)
  classe    String

  @@index([eleveId])
  @@index([date])
  @@index([classe])
  @@map("presences")
}

model Etablissement {
  id          String   @id @default(cuid())
  nom         String
  type        String   @default("")
  province    String   @default("")
  ville       String   @default("")
  adresse     String   @default("")
  telephone   String   @default("")
  email       String   @default("")
  effectif   Int      @default(0)
  statut      String   @default("Actif")
  eleves      Eleve[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([province])
  @@index([type])
  @@map("etablissements")
}
