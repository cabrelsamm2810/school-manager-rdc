generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  COORDINATION_NATIONALE
  COORDINATION_PROVINCIALE
  AGENT_PROVINCIAL
  COORDINATION_SOUS_PROVINCIALE
  AGENT_SOUS_PROVINCIAL
  DIRECTION_ECOLE
  ENSEIGNANT
  PARENT
  ELEVE
}

model User {
  id              String   @id @default(cuid())
  nom             String
  postNom        String   @default("")
  prenom          String
  email           String   @unique
  telephone       String   @default("")
  passwordHash    String
  role            Role     @default(ELEVE)
  profilePhotoUrl String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Eleve {
  id              String    @id @default(cuid())
  matricule       String    @unique
  nom             String
  postNom         String    @default("")
  prenom          String
  sexe            String    @default("")
  dateNaissance   DateTime?
  lieuNaissance   String    @default("")
  classe          String
  telephone       String    @default("")
  email           String    @default("")
  adresse         String    @default("")
  nomTuteur       String    @default("")
  telephoneTuteur String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([classe])
  @@index([nom])
  @@map("eleves")
}

model Etablissement {
  id          String   @id @default(cuid())
  nom         String
  type        String   @default("")
  province    String   @default("")
  ville       String   @default("")
  adresse     String   @default("")
  telephone   String   @default("")
  email       String   @default("")
  effectif   Int      @default(0)
  statut      String   @default("Actif")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([province])
  @@index([type])
  @@map("etablissements")
}
