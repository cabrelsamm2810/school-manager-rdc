generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  COORDINATION_NATIONALE
  COORDINATION_PROVINCIALE
  AGENT_PROVINCIAL
  COORDINATION_SOUS_PROVINCIALE
  AGENT_SOUS_PROVINCIAL
  DIRECTION_ECOLE
  ENSEIGNANT
  PARENT
  ELEVE
}

model User {
  id                    String   @id @default(cuid())
  nom                   String
  postNom               String   @default("")
  prenom                String
  sexe                  String   @default("")
  email                 String   @unique
  telephone             String   @default("")
  passwordHash          String
  role                  Role     @default(ELEVE)
  typeInstitution       String   @default("")
  institutionName      String   @default("")
  provinceAdministrative String  @default("")
  provinceEducationnelle String  @default("")
  bureauAffectation     String   @default("")
  fonction              String   @default("")
  grade                 String   @default("")
  dinacope              String   @default("")
  profilePhotoUrl       String?
  validationCode        String?
  isActive              Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Eleve {
  id              String    @id @default(cuid())
  matricule       String    @unique
  nom             String
  postNom         String    @default("")
  prenom          String
  sexe            String    @default("")
  dateNaissance   DateTime?
  lieuNaissance   String    @default("")
  classe          String
  telephone       String    @default("")
  email           String    @default("")
  adresse         String    @default("")
  nomTuteur       String    @default("")
  telephoneTuteur String    @default("")
  etablissementId String?
  etablissement   Etablissement? @relation(fields: [etablissementId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  presences  Presence[]

  @@index([classe])
  @@index([nom])
  @@index([etablissementId])
  @@map("eleves")
}

model Presence {
  id        String   @id @default(cuid())
  eleveId   String
  eleve     Eleve    @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  present   Boolean  @default(true)
  classe    String

  @@index([eleveId])
  @@index([date])
  @@index([classe])
  @@map("presences")
}

model Etablissement {
  id          String   @id @default(cuid())
  nom         String
  type        String   @default("")
  province    String   @default("")
  ville       String   @default("")
  adresse     String   @default("")
  telephone   String   @default("")
  email       String   @default("")
  effectif   Int      @default(0)
  statut      String   @default("Actif")
  eleves      Eleve[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([province])
  @@index([type])
  @@map("etablissements")
}

model Enseignant {
  id            String   @id @default(cuid())
  nom           String
  matricule     String   @unique
  grade         String   @default("")
  etablissement String   @default("")
  specialite    String   @default("")
  telephone     String   @default("")
  email         String   @default("")
  statut        String   @default("Actif")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([nom])
  @@index([etablissement])
  @@map("enseignants")
}

model Province {
  id            String   @id @default(cuid())
  nom           String   @unique
  chefLieu      String   @default("")
  etablissements Int     @default(0)
  eleves        Int      @default(0)
  statut        String   @default("Actif")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([nom])
  @@map("provinces")
}

model EcErc {
  id        String   @id @default(cuid())
  nom       String
  type      String   @default("")
  province  String   @default("")
  ecoles    Int      @default(0)
  statut    String   @default("Actif")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([province])
  @@map("ec_erc")
}

model CoordNationale {
  id            String   @id @default(cuid())
  province      String
  coordonnateur String   @default("")
  ecoles        Int      @default(0)
  eleves        Int      @default(0)
  statut        String   @default("Actif")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([province])
  @@map("coord_nationale")
}

model CoordProvinciale {
  id        String   @id @default(cuid())
  province  String
  bureaux   Int      @default(0)
  agents    Int      @default(0)
  dossiers  Int      @default(0)
  statut    String   @default("Actif")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([province])
  @@map("coord_provinciale")
}

model CoordSousProvinciale {
  id        String   @id @default(cuid())
  nom       String
  province  String   @default("")
  bureaux   Int      @default(0)
  agents    Int      @default(0)
  statut    String   @default("Actif")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([province])
  @@map("coord_sous_provinciale")
}

model Bureau {
  id           String   @id @default(cuid())
  bureau       String
  fonction     String   @default("")
  titulaire    String   @default("")
  localisation String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([bureau])
  @@map("bureaux")
}

model Grade {
  id        String   @id @default(cuid())
  grade     String
  categorie String   @default("")
  effectif  Int      @default(0)
  statut    String   @default("Actif")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([grade])
  @@map("grades")
}

model Dossier {
  id        String   @id @default(cuid())
  reference String   @unique
  objet     String
  demandeur String   @default("")
  statut    String   @default("En attente")
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reference])
  @@index([statut])
  @@map("dossiers")
}

model Visite {
  id           String   @id @default(cuid())
  date         DateTime @default(now())
  etablissement String
  visiteur     String   @default("")
  objet        String   @default("")
  statut       String   @default("Planifiée")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([etablissement])
  @@index([date])
  @@map("visites")
}

model ServiceAdmin {
  id         String   @id @default(cuid())
  service    String
  procedures Int      @default(0)
  dossiers   Int      @default(0)
  statut     String   @default("Actif")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([service])
  @@map("services_admin")
}

model Notification {
  id        String   @id @default(cuid())
  titre     String
  message   String   @default("")
  type      String   @default("")
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([lu])
  @@index([type])
  @@map("notifications")
}

model Paiement {
  id          String   @id @default(cuid())
  reference   String   @unique
  description String
  montant     String   @default("")
  date        DateTime @default(now())
  statut      String   @default("En attente")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([reference])
  @@index([statut])
  @@map("paiements")
}

model Note {
  id        String   @id @default(cuid())
  eleve     String
  classe    String   @default("")
  devoir1   String   @default("")
  devoir2   String   @default("")
  examen    String   @default("")
  moyenne   String   @default("")
  mention   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eleve])
  @@index([classe])
  @@map("notes")
}
