# Valeurs locales de développement pour le sandbox Base44 — AUCUN secret réel.
# Chargé AVANT /run/base44/app.env : une valeur réelle fournie par l'utilisateur
# (Cloudflare R2) écrase toujours celle-ci (docker compose : le dernier env_file gagne).
#
# Le bucket de développement est le service local `s3mock` — R2 est compatible S3,
# donc le même code (lib/storage.ts) est exercé en local et en production.

STORAGE_PROVIDER=s3
S3_ENDPOINT=http://s3mock:9090
S3_REGION=us-east-1
S3_BUCKET=school-manager-rdc
S3_ACCESS_KEY_ID=dev-s3mock
S3_SECRET_ACCESS_KEY=dev-s3mock
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
# S3_PUBLIC_ENDPOINT reste vide : les lectures passent par /api/files
# (serveur authentifié), les URL signées ne sont pas nécessaires en local.
