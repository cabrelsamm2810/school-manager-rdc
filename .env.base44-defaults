# Base44 development defaults (placeholders only, safe to commit).
# These point the app at the local compose PostgreSQL service so it boots without credentials.
# Secrets uploaded from the Base44 dashboard land in /run/base44/app.env and are loaded AFTER
# this file, so real values always win.
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="School Manager RDC"
APP_ENV=development

# Local PostgreSQL from docker-compose.base44.yml. Set DATABASE_URL/DIRECT_URL secrets in the
# Base44 dashboard to use an external (e.g. Supabase) database instead.
DATABASE_URL="postgresql://school_manager:school_manager_dev@db:5432/school_manager?schema=public"
DIRECT_URL="postgresql://school_manager:school_manager_dev@db:5432/school_manager?schema=public"

# Server-only session settings.
SESSION_COOKIE_NAME="school_manager_session"
SESSION_MAX_AGE="604800"
SESSION_SECRET="dev-session-secret-change-me"

# Storage abstraction placeholders (not implemented yet in the app code).
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
FILE_MAX_SIZE="10485760"
