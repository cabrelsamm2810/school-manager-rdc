# Public application settings
NEXT_PUBLIC_APP_NAME="School Manager RDC"
NODE_ENV="development"

# Supabase > Project Settings > Database > Connection string
# Use the Transaction Pooler URL for DATABASE_URL (port 6543, pgbouncer=true).
# Replace every <...> placeholder locally; never commit the resulting .env file.
DATABASE_URL="postgresql://postgres.<project-ref>:<database-password>@<pooler-host>:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Supabase direct/session connection, used by Prisma CLI migrations.
# Use the Session pooler (5432) or direct database host from the same page.
DIRECT_URL="postgresql://postgres.<project-ref>:<database-password>@<database-host>:5432/postgres?sslmode=require"

# Server-only session settings. Generate the secret locally; do not commit it.
SESSION_COOKIE_NAME="school_manager_session"
SESSION_MAX_AGE="604800"
SESSION_SECRET=""

# Optional Supabase client settings. Not required by Prisma-only server code.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

APP_ENV="development"

# ── Cloudflare R2 (stockage des fichiers) ──
# Récupérez ces valeurs depuis le tableau de bord Cloudflare R2 :
#   R2_ACCOUNT_ID        → Cloudflare → R2 → Overview (account ID en haut de page)
#   R2_ACCESS_KEY_ID     → R2 → Manage R2 API Tokens → Create API token (permission Object Read & Write)
#   R2_SECRET_ACCESS_KEY → généré en même temps que l'access key
#   R2_BUCKET_NAME       → nom du bucket R2 créé (bucket privé recommandé)
#   R2_PUBLIC_URL        → (optionnel) URL publique du bucket, si activé dans R2 → Settings → Public access
#                         Laissez vide pour utiliser des URL signées temporaires (bucket privé).
#
# Sans ces variables, les fichiers sont stockés localement dans public/uploads/ (comportement par défaut).
# Les photos de profil utilisent une URL publique si R2_PUBLIC_URL est configuré, sinon une URL signée.
# Les fichiers de chat, documents école et documents élève utilisent toujours des URL signées.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
