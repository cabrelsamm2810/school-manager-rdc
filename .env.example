# Public application settings
NEXT_PUBLIC_APP_NAME="School Manager RDC"
NODE_ENV="development"

# Supabase > Project Settings > Database > Connection string
# Use the Transaction Pooler URL for DATABASE_URL (port 6543, pgbouncer=true).
# Replace every <...> placeholder locally; never commit the resulting .env file.
DATABASE_URL="postgresql://postgres.<project-ref>:<database-password>@<pooler-host>:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Supabase direct/session connection, used by Prisma CLI migrations.
# Use the Session pooler (5432) or direct database host from the same page.
DIRECT_URL="postgresql://postgres.<project-ref>:<database-password>@<database-host>:5432/postgres?sslmode=require"

# Server-only session settings. Generate the secret locally; do not commit it.
SESSION_COOKIE_NAME="school_manager_session"
SESSION_MAX_AGE="604800"
SESSION_SECRET=""

# Optional Supabase client settings. Not required by Prisma-only server code.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ─────────────────────────────────────────────────────────────
# Stockage de fichiers — Cloudflare R2 (SDK S3 compatible, côté serveur uniquement)
# ─────────────────────────────────────────────────────────────
# Ces valeurs ne doivent JAMAIS être exposées au navigateur : aucun préfixe
# NEXT_PUBLIC_. Côté Vercel, les définir dans Project > Settings > Environment
# Variables (Production / Preview / Development) et ne jamais les commiter.
#
# Cloudflare > R2 > Overview > « Manage R2 API Tokens » (droits Object Read & Write
# sur le bucket) pour S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY.
STORAGE_PROVIDER="s3"
# Endpoint S3 de R2 : https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=""
# « auto » pour R2.
S3_REGION="auto"
# Bucket privé (les fichiers ne sont jamais exposés publiquement).
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# true (défaut) = URLs en style chemin, accepté par R2 et les S3 locaux.
S3_FORCE_PATH_STYLE="true"
# Facultatif : endpoint joignable par le navigateur. S'il est défini, /api/files
# redirige vers une URL signée temporaire (recommandé sur Vercel, qui limite la
# taille des réponses de fonctions serverless) au lieu de servir les octets.
# Laisser vide en développement local.
S3_PUBLIC_ENDPOINT=""
# Durée de validité des URL signées, en secondes (défaut 300).
S3_SIGNED_URL_TTL="300"
# Développement local uniquement : crée le bucket s'il n'existe pas.
S3_AUTO_CREATE_BUCKET="false"
# Limite globale par fichier (octets) ; les politiques par usage restent appliquées.
FILE_MAX_SIZE="10485760"

APP_ENV="development"
