NEXT_PUBLIC_APP_NAME="School Manager RDC"
NODE_ENV="development"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_manager_rdc?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/school_manager_rdc?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REMPLACEZ_PAR_UNE_CLE_SECRETE_SECURE"

SESSION_COOKIE_NAME="school_manager_session"
SESSION_MAX_AGE="604800"

STORAGE_PROVIDER="s3"
S3_ENDPOINT="https://s3.example.com"
S3_REGION="us-east-1"
S3_BUCKET="school-manager-rdc"
S3_ACCESS_KEY_ID="replace-me"
S3_SECRET_ACCESS_KEY="replace-me"
S3_FORCE_PATH_STYLE="true"

FILE_MAX_SIZE="10485760"
APP_ENV="development"
