# Application
NEXT_PUBLIC_APP_NAME=School Manager RDC
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_manager_rdc?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/school_manager_rdc?schema=public"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-strong-secret"

# File storage / S3-compatible
STORAGE_PROVIDER="s3"
S3_ENDPOINT="https://s3.example.com"
S3_REGION="us-east-1"
S3_BUCKET="school-manager-rdc"
S3_ACCESS_KEY_ID="replace-me"
S3_SECRET_ACCESS_KEY="replace-me"
S3_FORCE_PATH_STYLE="true"

# App config
FILE_MAX_SIZE=10485760
APP_ENV="development"

# Email / notifications
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
